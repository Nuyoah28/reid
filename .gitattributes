# Preserve the byte conventions used by the v2 experiment SHA256 records.
# Research sources were written as LF; upstream OSNet was checked out as CRLF.
/occluded_reid/code/reid/*.py text eol=lf
/occluded_reid/code/occlusion_v2/*.py text eol=lf
/occluded_reid/code/train.py text eol=lf
/occluded_reid/code/train_occlusion_v2.py text eol=lf
