/occluded_reid/research/occlusion_v2_protocol.json text eol=lf
/occluded_reid/research/occlusion_v2_evaluation_source_freeze.json text eol=crlf
# JSON/log records are emitted by Python text I/O on Windows.
/occluded_reid/results/peer_v2_*/config.json text eol=crlf
